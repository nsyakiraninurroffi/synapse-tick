// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  pengunjung
  organizer
  staff
  vendor
}

enum TicketStatus {
  booking
  lunas
  check_in
  expired
  refunded
}

enum TransactionStatus {
  pending
  success
  failed
  refunded
}

enum TransactionType {
  beli_tiket
  topup_wallet
}

enum EventCategory {
  konser
  seminar
  workshop
  festival
  theater
  olahraga
  exhibition
  lainnya
}

enum SeatingType {
  zone
  numbered
  general
  timed_entry
}

model User {
  id        String   @id @default(uuid())
  nama      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  noHp      String?  @map("no_hp") @db.VarChar(20)
  role      Role     @default(pengunjung)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  provider  String?  @db.VarChar(50) // google, facebook, tiktok
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events       Event[]
  tickets      Ticket[]
  transactions Transaction[]
  wallet       Wallet?
  vendors      Vendor[]

  @@map("users")
}

model Event {
  id              String        @id @default(uuid())
  organizerId     String        @map("organizer_id")
  namaEvent       String        @map("nama_event") @db.VarChar(200)
  lokasi          String        @db.VarChar(255)
  tanggal         DateTime
  kapasitas       Int
  logoUrl         String?       @map("logo_url") @db.VarChar(500)
  bannerUrl       String?       @map("banner_url") @db.VarChar(500)
  deskripsi       String?       @db.Text
  isPublished     Boolean       @default(false) @map("is_published")
  kategoriEvent   EventCategory @default(konser) @map("kategori_event")
  seatingType     SeatingType   @default(zone) @map("seating_type")
  jamBuka         String?       @map("jam_buka") @db.VarChar(10)
  jamTutup        String?       @map("jam_tutup") @db.VarChar(10)
  syaratKetentuan String?       @map("syarat_ketentuan") @db.Text
  minAge          Int?          @map("min_age")
  maxTicketPerUser Int          @default(4) @map("max_ticket_per_user")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organizer    User           @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  seats        Seat[]
  tickets      Ticket[]
  vendors      Vendor[]
  transactions Transaction[]
  promoCodes   PromoCode[]

  @@map("events")
}

model Seat {
  id        String  @id @default(uuid())
  eventId   String  @map("event_id")
  kategori  String  @db.VarChar(50) // VVIP, VIP, Festival, Reguler, Tribune A, dll
  harga     Decimal @db.Decimal(12, 2)
  kuota     Int
  deskripsi String? @db.VarChar(255) // "Dekat panggung, termasuk lanyard"
  benefits  String? @db.Text          // JSON: ["Free merchandise", "Priority entrance"]
  warna     String? @db.VarChar(20)   // "#8B5CF6" for zone color
  sortOrder Int     @default(0) @map("sort_order")

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@map("seats")
}

model Ticket {
  id        String       @id @default(uuid())
  eventId   String       @map("event_id")
  userId    String       @map("user_id")
  seatId    String       @map("seat_id")
  qrToken   String       @map("qr_token") @db.Text
  status    TicketStatus @default(booking)
  checkInAt DateTime?    @map("check_in_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat  Seat  @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model Transaction {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  eventId          String?           @map("event_id")
  jumlah           Decimal           @db.Decimal(12, 2)
  diskon           Decimal           @default(0) @db.Decimal(12, 2)
  totalBayar       Decimal           @default(0) @map("total_bayar") @db.Decimal(12, 2)
  metodePembayaran String            @map("metode_pembayaran") @db.VarChar(50)
  status           TransactionStatus @default(pending)
  tipeTransaksi    TransactionType   @map("tipe_transaksi")
  referenceId      String?           @unique @map("reference_id") @db.VarChar(100)
  snapToken        String?           @map("snap_token") @db.VarChar(255)
  snapUrl          String?           @map("snap_url") @db.VarChar(500)
  promoCodeId      String?           @map("promo_code_id")
  expiredAt        DateTime?         @map("expired_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id])

  @@map("transactions")
}

model PromoCode {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  kode          String   @unique @db.VarChar(50)
  diskon        Decimal  @db.Decimal(12, 2)
  isPercentage  Boolean  @default(false) @map("is_percentage")
  kuota         Int
  terpakai      Int      @default(0)
  berlakuSampai DateTime @map("berlaku_sampai")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("promo_codes")
}

model Wallet {
  id     String  @id @default(uuid())
  userId String  @unique @map("user_id")
  nfcUid String? @map("nfc_uid") @db.VarChar(100)
  saldo  Decimal @default(0) @db.Decimal(12, 2)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  boothTransactions BoothTransaction[] @relation("WalletBoothTransactions")

  @@map("wallets")
}

model Vendor {
  id        String @id @default(uuid())
  eventId   String @map("event_id")
  ownerId   String @map("owner_id")
  namaBooth String @map("nama_booth") @db.VarChar(150)

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boothTransactions BoothTransaction[] @relation("VendorBoothTransactions")

  @@map("vendors")
}

model BoothTransaction {
  id         String   @id @default(uuid())
  vendorId   String   @map("vendor_id")
  walletId   String   @map("wallet_id")
  nominal    Decimal  @db.Decimal(12, 2)
  status     String   @db.VarChar(50) @default("success")
  keterangan String?  @db.VarChar(255)
  waktu      DateTime @default(now())

  vendor Vendor @relation("VendorBoothTransactions", fields: [vendorId], references: [id], onDelete: Cascade)
  wallet Wallet @relation("WalletBoothTransactions", fields: [walletId], references: [id], onDelete: Cascade)

  @@map("booth_transactions")
}
